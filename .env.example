# Copy this file to .env.local and fill in your Google OAuth Client ID.
# This value is PUBLIC (it ships in the browser bundle) and is NOT a secret —
# it is protected by the Authorized JavaScript origins allowlist in Google Cloud.
# There is NO API key and NO client secret in this app (pure client-side flow).
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
